# Copy to .env for local development. Keep .env out of Git.
MLOPS_DASHBOARD_RUNTIME=local
ULRPM_MACHINE_IDS_FILE=data/unique_machine_ids.txt

# Set these to the approved read-only Feature Store source for your environment.
# The application has a development default account/container; overrides should
# be configured locally rather than committed here.
# FST_PROD_ACCOUNT_NAME=<approved-fst-account>
# FST_PROD_CONTAINER=<approved-fst-container>
# FST_PROD_ACCOUNT_KEY=
# FST_PROD_SAS_TOKEN=

# Mongo lifecycle lookup: configure MONGODB_URL locally, or explicitly enable
# Azure Key Vault lookup with an authenticated local Azure identity. Leave blank
# in Git and never paste a connection string into this file for a commit.
MONGODB_URL=
MONGODB_KEY_VAULT_ENABLED=0
# MONGODB_KEY_VAULT_NAME=<approved-vault-name>

# Optional Databricks Silver comparison; leave disabled unless configured.
DATABRICKS_SILVER_ENABLED=0
# DATABRICKS_PROFILE=<local-profile-name>
# DATABRICKS_WAREHOUSE_ID=<approved-warehouse-id>

# Workflow mutations are intentionally disabled by default in every package.
BACKFILL_DISPATCH_ENABLED=0
BACKFILL_PRODUCTION_MODE=0

# Optional read-only cost report integration.
# OUTERBOUNDS_COST_REPORT_API_URL=<approved-api-url>
# OUTERBOUNDS_COST_REPORT_TOKEN=
