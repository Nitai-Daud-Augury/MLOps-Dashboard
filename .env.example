# Copy to .env for local development. Keep .env out of Git.
MLOPS_DASHBOARD_RUNTIME=local
ULRPM_MACHINE_IDS_FILE=data/unique_machine_ids.txt
MLOPS_TEST_MACHINE_IDS_FILE=data/test_machine_ids.txt
# Optional comma-separated additive test IDs; default registry already includes known test assets.
# MLOPS_TEST_MACHINE_IDS=<24-character-machine-id>

# Set these to the approved read-only Feature Store source for your environment.
# The application has a development default account/container; overrides should
# be configured locally rather than committed here.
# FST_PROD_ACCOUNT_NAME=<approved-fst-account>
# FST_PROD_CONTAINER=<approved-fst-container>
# FST_PROD_ACCOUNT_KEY=
# FST_PROD_SAS_TOKEN=

# FST scan concurrency. BACKFILL_SCAN_WORKERS threads read Feature Store blobs in
# parallel (default 12). All workers share ONE process-wide blob client whose
# HTTP connection pool is sized max(BACKFILL_SCAN_WORKERS + 4, 10, BACKFILL_BLOB_POOL_SIZE),
# so urllib3 never logs "Connection pool is full". BACKFILL_BLOB_POOL_SIZE is an
# optional override that can only raise the pool, never shrink it below workers.
# BACKFILL_SCAN_WORKERS=12
# BACKFILL_BLOB_POOL_SIZE=

# Lifecycle enrichment source: databricks | mongo | openapi | off
# databricks is what the deployed app uses (app.yaml). The code default when
# unset is still mongo, to preserve the previous local behavior.
LIFECYCLE_SOURCE=databricks
# Bronze Mongo machines_raw (latest snapshot per _id). Legacy DATABRICKS_EQUIPMENT_TABLE still accepted.
# DATABRICKS_MACHINES_RAW_TABLE=dih_prod.bronze_augury_mh_mongodb.machines_raw
# installation_at prefers raw_json.created_at; firstRecorded.timestamp is fallback only.
# Test badge: name/tag heuristics + company in {QA, Demo, Hagay test lab, dynamicsScopingTest}
# plus data/test_machine_ids.txt / MLOPS_TEST_MACHINE_IDS override.

# Mongo lifecycle lookup (LIFECYCLE_SOURCE=mongo): configure MONGODB_URL locally,
# or explicitly enable Azure Key Vault lookup with an authenticated local Azure
# identity. Leave blank in Git and never paste a connection string into this
# file for a commit.
MONGODB_URL=
MONGODB_KEY_VAULT_ENABLED=0
# MONGODB_KEY_VAULT_NAME=<approved-vault-name>

# Databricks SQL (Silver comparison and/or LIFECYCLE_SOURCE=databricks).
# DATABRICKS_PROFILE is local-only and optional: when set, that ~/.databrickscfg
# profile is used; when unset, the databricks-sdk default auth chain is used.
# Inside Databricks Apps it is ignored (the app service principal is used).
DATABRICKS_PROFILE=mlops-dev
DATABRICKS_WAREHOUSE_ID=6ed9ddd0b2661edc
# Optional Databricks Silver comparison; leave disabled unless configured.
# Default table is the live dih_prod.silver_mh.feature_store
# (dih_prod.silver_mh.features is deprecated and stale).
DATABRICKS_SILVER_ENABLED=0
# DATABRICKS_SILVER_TABLE=dih_prod.silver_mh.feature_store

# Optional, informational Feature Store cross-check (default off). When set to
# feature_store, each scan also aggregates rows + v2 ultrasonic non-null counts
# per machine/month from DATABRICKS_FEATURE_STORE_TABLE (same profile/warehouse
# as above) and flags months that disagree with blob. Blob stays the source of
# truth: statuses never change. Schema completeness is NOT compared
# (vs the canonical FST contract, Databricks has 23 truly absent columns plus
# 11 case-duplicate column pairs it collapses). Fail-open on any error.
# Staleness gate: the bronze mirror only re-merges the current and previous
# month nightly, so blob files rewritten later (backfilled older months) show
# as feature_store_stale ("Databricks copy is older than blob"), not mismatches.
# FEATURES_CROSSCHECK=feature_store
# DATABRICKS_FEATURE_STORE_TABLE=dih_prod.silver_mh.feature_store
# DATABRICKS_FEATURE_STORE_BRONZE_TABLE=dih_prod.bronze_augury_mh_blob.feature_store
# Flag when blob_rows / feature_store_rows is outside [1 - tol, 1 + tol].
# FEATURES_CROSSCHECK_ROW_TOLERANCE=0.10
# Overall ceiling for the cross-check query (seconds); SQL also uses the
# LIFECYCLE_DATABRICKS_TIMEOUT_SECONDS / _COLD_TIMEOUT_SECONDS budgets.
# FEATURES_CROSSCHECK_TIMEOUT_SECONDS=300

# Workflow mutations are intentionally disabled by default in every package.
BACKFILL_DISPATCH_ENABLED=0
BACKFILL_PRODUCTION_MODE=0

# Optional read-only cost report integration.
# OUTERBOUNDS_COST_REPORT_API_URL=<approved-api-url>
# OUTERBOUNDS_COST_REPORT_TOKEN=

# Seconds before Databricks lifecycle auth/SQL fail-opens (scan continues).
# Steady-state SQL timeout after the warehouse is warm (default 45).
# LIFECYCLE_DATABRICKS_TIMEOUT_SECONDS=45
# First SQL / cold-retry budget when the warehouse is stopped (default 180).
# Must be >= TIMEOUT_SECONDS. Cold start often needs ~2 minutes.
# LIFECYCLE_DATABRICKS_COLD_TIMEOUT_SECONDS=180

# Read-only Outerbounds connectivity probe (Admin > Outerbounds probe;
# POST /api/diagnostics/outerbounds). Off unless set to 1; both routes 404 when off.
# Credentials come from ~/.metaflowconfig (outerbounds configure) or, env-only,
# METAFLOW_SERVICE_AUTH_KEY + OBP_METAFLOW_CONFIG_URL. Never commit a token.
OUTERBOUNDS_PROBE_ENABLED=0
# Trigger stage stays skipped unless this is 1 AND the request sets include_trigger
# AND OUTERBOUNDS_PROBE_DEPLOYMENT_ID is configured (and matches the request).
OUTERBOUNDS_PROBE_TRIGGER_ENABLED=0
# OUTERBOUNDS_PROBE_DEPLOYMENT_ID=
OUTERBOUNDS_DEPLOYMENT_DOMAIN=augury.obp.outerbounds.com
OUTERBOUNDS_PERIMETER=default
OUTERBOUNDS_PROBE_FLOW_ALLOWLIST=FSTBackfill
# OUTERBOUNDS_PROBE_EXTRA_HOST=
# OUTERBOUNDS_PROBE_STAGE_TIMEOUT_SECONDS=20
